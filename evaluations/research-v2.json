{
  "version": 2,
  "protocol": "scripted-vs-live-v2",
  "notes": "Development cases may guide changes. Held-out wording is excluded from planner templates and prompts. Locally authored and visible to the implementer, not an independently blinded test. Freeze the file hash before scoring; never tune against held-out failures in this version.",
  "cases": [
    {
      "id": "dev-latency",
      "split": "development",
      "category": "supported",
      "question": "How does increased quote latency affect market-maker P&L and inventory risk?",
      "expect": "completed",
      "controls": {
        "quote_refresh_interval": 5
      },
      "metrics": [
        "ending_pnl_ticks",
        "max_abs_inventory"
      ],
      "baseline": {
        "quote_refresh_interval": 1
      }
    },
    {
      "id": "dev-inventory",
      "split": "development",
      "category": "supported",
      "question": "Does a tighter inventory limit reduce losses under more informed order flow?",
      "expect": "completed",
      "controls": {
        "max_inventory": 20
      },
      "metrics": [
        "ending_pnl_ticks"
      ],
      "baseline": {
        "max_inventory": 100,
        "informed_share": 0.7
      }
    },
    {
      "id": "dev-tradeoff",
      "split": "development",
      "category": "supported",
      "question": "Which tested configuration has the best tradeoff between P&L and drawdown?",
      "expect": "completed",
      "controls": {
        "max_inventory": 20,
        "half_spread_ticks": 6
      },
      "metrics": [
        "ending_pnl_ticks",
        "max_drawdown_ticks"
      ],
      "baseline": {
        "max_inventory": 100,
        "half_spread_ticks": 3
      }
    },
    {
      "id": "dev-volatility",
      "split": "development",
      "category": "supported",
      "question": "How does higher volatility affect execution edge?",
      "expect": "completed",
      "controls": {
        "volatility_ticks": 10
      },
      "metrics": [
        "execution_edge_pnl_ticks"
      ],
      "baseline": {
        "volatility_ticks": 4
      }
    },
    {
      "id": "dev-spread",
      "split": "development",
      "category": "supported",
      "question": "How does a wider spread affect P&L?",
      "expect": "completed",
      "controls": {
        "half_spread_ticks": 6
      },
      "metrics": [
        "ending_pnl_ticks"
      ],
      "baseline": {
        "half_spread_ticks": 3
      }
    },
